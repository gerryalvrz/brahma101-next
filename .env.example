# Server-side Supabase (contact form / API). Never commit real keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Venice AI — Hydra assist on /art + Strudel assist on /create-music (server-only)
VENICE_API_KEY=your_venice_api_key
# Prefer a small/fast model for assist tutors (simple syntax tutoring)
# Examples: qwen3-5-9b | llama-3.2-3b | zai-org-glm-4.7-flash | deepseek-v4-flash
VENICE_MODEL=qwen3-5-9b

# The Movie Database — World Cinema Explorer on /cinema (server-only, never NEXT_PUBLIC_)
TMDB_API_KEY=
